# Local Studio (default) — Nest API on this machine
NEXT_PUBLIC_API_URL=http://localhost:4003/v1

# Production / Vercel: set this in the Vercel project Environment Variables to a
# publicly reachable sarupak-api (Nest). Leave unset/localhost and Studio will
# show that the hosted site has no backend (creative tools still work).
# NEXT_PUBLIC_API_URL=https://your-sarupak-api.example.com/v1

NEXT_PUBLIC_WORKER_URL=
