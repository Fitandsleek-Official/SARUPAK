# Host Postgres (Phase 1 default when Docker is unavailable)
DATABASE_URL=postgresql://hi@127.0.0.1:5432/sarupak?schema=public

# Or Docker Compose Postgres on port 5433:
# DATABASE_URL=postgresql://sarupak:sarupak@127.0.0.1:5433/sarupak?schema=public

JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d

# Phase 5.2 stable local ports — do NOT use 4000/3000 (often other apps).
# See docs/development/PORTS.md
PORT=4003
CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010,http://localhost:3000,http://127.0.0.1:3000

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
MAX_UPLOAD_BYTES=524288000
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Phase 3 — STT / subtitles
# STT_PROVIDER=mock|openai-whisper|whisper-cli|silence-segments (empty = auto)
STT_PROVIDER=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_WHISPER_MODEL=whisper-1
WHISPER_CLI_PATH=whisper
WHISPER_MODEL=base

# Phase 4 — Dubbing / TTS / separation / diarization
# TTS_PROVIDER=mock|openai-tts — empty means no silent default to mock (Phase 5).
# For automated tests, set TTS_PROVIDER=mock explicitly.
TTS_PROVIDER=mock
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
# SEPARATION_PROVIDER=passthrough|demucs|unavailable
SEPARATION_PROVIDER=passthrough
# DIARIZATION_PROVIDER=mock|manual|unavailable
DIARIZATION_PROVIDER=manual
DEMUCS_PATH=demucs
